<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Permite acceso a miembros internal de Core desde el proyecto de tests (ej. BuildCanonicalBytes). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RenderByte.Sync.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
